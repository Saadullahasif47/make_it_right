/**
 * Prints (or writes) environment variables for the local Supabase CLI stack, so developers
 * and CI never copy keys by hand. The local keys are the CLI's per-machine development keys.
 *
 *   node scripts/local-supabase-env.mts            # print KEY=value lines (CI: >> $GITHUB_ENV)
 *   node scripts/local-supabase-env.mts --write    # create .env.local (refuses to overwrite)
 *   node scripts/local-supabase-env.mts --write --force
 */
import { execSync } from "node:child_process";
import { existsSync, writeFileSync } from "node:fs";

interface LocalStatus {
  readonly API_URL: string;
  readonly PUBLISHABLE_KEY: string;
  readonly SECRET_KEY: string;
  readonly MAILPIT_URL?: string;
}

function readStatus(): LocalStatus {
  // A constant command (no interpolated input); a shell is needed for pnpm.cmd on Windows.
  const output = execSync("pnpm exec supabase status -o json", {
    encoding: "utf8",
    stdio: ["ignore", "pipe", "ignore"],
  });
  const jsonStart = output.indexOf("{");
  const status = JSON.parse(output.slice(jsonStart)) as Partial<LocalStatus>;
  if (
    status.API_URL === undefined ||
    status.PUBLISHABLE_KEY === undefined ||
    status.SECRET_KEY === undefined
  ) {
    throw new Error("Local Supabase is not running. Start it with `pnpm db:start`.");
  }
  return status as LocalStatus;
}

const status = readStatus();
const appPort = process.env.APP_PORT ?? "3000";

const lines = [
  "# Local development against the Supabase CLI stack. Generated by scripts/local-supabase-env.mts.",
  `APP_BASE_URL=http://localhost:${appPort}`,
  "LOG_LEVEL=info",
  `NEXT_PUBLIC_SUPABASE_URL=${status.API_URL}`,
  `NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=${status.PUBLISHABLE_KEY}`,
  "# Scripts and tests only; the application never reads this.",
  `SUPABASE_SECRET_KEY=${status.SECRET_KEY}`,
  `MAILPIT_URL=${status.MAILPIT_URL ?? "http://127.0.0.1:54324"}`,
  "AI_ENABLED=false",
];

const args = new Set(process.argv.slice(2));
if (args.has("--write")) {
  if (existsSync(".env.local") && !args.has("--force")) {
    console.error(".env.local already exists; pass --force to replace it.");
    process.exit(1);
  }
  writeFileSync(".env.local", `${lines.join("\n")}\n`, { encoding: "utf8" });
  console.log("Wrote .env.local for the local Supabase stack.");
} else {
  console.log(lines.filter((line) => !line.startsWith("#")).join("\n"));
}
