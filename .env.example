# MakeItRight environment contract (master plan §14).
# Copy to .env.local for local development, or generate it with `pnpm db:env` once the local
# Supabase stack is running. Never commit .env.local or real keys.
# Only NEXT_PUBLIC_* values are sent to the browser; everything else stays on the server.

# ---- Application ----------------------------------------------------------
# Exact origin used in emailed links. Set it in production; previews derive it per request.
APP_BASE_URL=http://localhost:3000
# debug | info | warn | error
LOG_LEVEL=info

# ---- Supabase (required) --------------------------------------------------
# Project URL and the PUBLISHABLE key (sb_publishable_...). Access is enforced by RLS.
# The app refuses to start if a secret key is pasted here.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...): only for scripts/tests (seed:demo, integration, e2e).
# The application never reads it. Never prefix it with NEXT_PUBLIC_ and never set it on Vercel.
SUPABASE_SECRET_KEY=
# Local email inbox used by the E2E tests.
MAILPIT_URL=http://127.0.0.1:54324

# ---- AI (Phase 4; optional, tickets are accepted without it) ---------------
AI_ENABLED=false
GEMINI_MODEL=gemini-3.1-flash-lite
# Server only. Use fictional complaints with the free tier.
# GEMINI_API_KEY=
