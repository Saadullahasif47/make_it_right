# MakeItRight environment contract (master plan §14).
# Copy to .env.local for local development. Never commit .env.local or real keys.
# Only NEXT_PUBLIC_* values are sent to the browser; everything else stays on the server.

# ---- Application ----------------------------------------------------------
# Exact deployment origin, used for auth redirects. Example: https://makeitright.vercel.app
APP_BASE_URL=http://localhost:3000
# debug | info | warn | error
LOG_LEVEL=info

# ---- Supabase (required from Phase 1) -------------------------------------
# Public project URL and publishable key; access is enforced by row-level security.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only, and only for isolated privileged modules. Never prefix with NEXT_PUBLIC_.
# SUPABASE_SECRET_KEY=

# ---- AI (Phase 4; optional, tickets are accepted without it) ---------------
AI_ENABLED=false
GEMINI_MODEL=gemini-3.1-flash-lite
# Server only. Use fictional complaints with the free tier.
# GEMINI_API_KEY=
